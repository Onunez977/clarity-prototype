# Copy to .env.kamal and fill in for a local Kamal deploy (`make kamal-deploy`).
# CI passes these via the workflow env instead (see .github/workflows/kamal-deploy.yml).

# ── AWS / ECR ─────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_PROFILE=
AWS_REGION=us-east-2
AWS_ECR_REPOSITORY=insight-lpr/platform

# ── Kamal targeting ───────────────────────────────────────────────────────────
KAMAL_SERVICE=platform-pr-123
KAMAL_SERVER=10.100.3.13
KAMAL_PROXY_HOST=pr-123-platform.internal.insightlpr.io
# TLS terminated upstream (ALB) — kamal-proxy speaks plain HTTP. The app still
# forces https URLs (AppServiceProvider). Set true only if kamal-proxy terminates TLS.
KAMAL_PROXY_SSL=false
KAMAL_SSH_USER=ubuntu
KAMAL_STORAGE_VOLUME=platform_pr_123_storage

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Platform
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:replace-with-app-key
APP_URL=https://pr-123-platform.internal.insightlpr.io

# ── Database (PostgreSQL + PostGIS, `platform` schema in `zod`) ───────────────
DB_CONNECTION=platform
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zod
DB_SEARCH_PATH=platform
DB_USERNAME=
DB_PASSWORD=

# ── Redis (single-node cluster booted by the deploy; both nodes -> accessory) ─
# In CI these are set to the redis accessory's container IP after slot assignment.
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_HOST_1=127.0.0.1
REDIS_HOST_2=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Drivers ───────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
FILESYSTEM_DISK=s3

# ── Websockets (baked into the image via Kamal builder args + runtime env) ─────
# Browser and Laravel both talk to Soketi at wss.insightlpr.io (not app.insightlpr.io).
PUSHER_HOST=wss.insightlpr.io
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=wss.insightlpr.io
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https

# ── ClickHouse Cloud ────────────────────────────────────────────────────────
CLICKHOUSE_DRIVER=clickhouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTPS=true
CLICKHOUSE_DATABASE_CLARITY=clarity
CLICKHOUSE_DATABASE_ZOD=zod
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_WRITE_USERNAME=default
CLICKHOUSE_WRITE_PASSWORD=

# ── AWS S3 (filesystem) ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# ── Maps (Vite build arg + runtime) ───────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@insightlpr.com
MAIL_FROM_NAME=Platform

# ── Broadcasting (optional; only used when BROADCAST_CONNECTION=pusher) ───────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# ── Misc integrations ─────────────────────────────────────────────────────────
GEOCODIO_API_KEY=
CONVERTAPI_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=
MATCHER_API_KEY=
MCP_BEARER_TOKEN=
