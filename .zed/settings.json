{
    "context_servers": {
        "mcp-atlassian": {
            "enabled": true,
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote",
                "https://mcp.atlassian.com/v1/sse"
            ]
        },
        "laravel-boost": {
            "enabled": true,
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
