{
    "name": "insight-lpr/platform",
    "type": "project",
    "version": "3.10.3",
    "keywords": ["insight-lpr"],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "aws/aws-sdk-php": "^3.339",
        "clickbar/laravel-magellan": "^1.8",
        "convertapi/convertapi-php": "^2.0",
        "datadog/php-datadogstatsd": "^1.7",
        "filament/filament": "^5.0",
        "geocodio/geocodio-library-php": "^2.0",
        "insight-lpr/black-adam": "^3.4",
        "insight-lpr/laravel-clickhouse-eloquent": "@dev",
        "insight-lpr/laravel-zod-migrations": "@dev",
        "laravel/ai": "^0.8.0",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.30",
        "laravel/nightwatch": "^1.13",
        "laravel/pennant": "^1.16",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.29",
        "livewire/livewire": "^4.2",
        "php-open-source-saver/jwt-auth": "^2.7",
        "pusher/pusher-php-server": "^7.2",
        "rap2hpoutre/fast-excel": "^5.5",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^4.16",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-slack-alerts": "^1.7",
        "tpetry/laravel-postgresql-enhanced": "^3.0",
        "tpetry/laravel-query-expressions": "^1.5",
        "twilio/sdk": "^8.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^1.0",
        "laravel/pint": "^1.21",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "pennant": "php artisan pennant:purge",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#fdba74\" \"php artisan serve\" \"npm run dev\" --names=server,vite --kill-others"
        ],
        "post-deploy": [
            "@php artisan config:clear --no-ansi --quiet",
            "@php artisan optimize --no-ansi --quiet",
            "@php artisan pennant:purge --no-ansi --quiet",
            "@php artisan filament:optimize --silent --env=production --no-ansi",
            "@php artisan horizon:terminate --no-ansi --quiet"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel-zod-migrations",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/black-adam",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/laravel-clickhouse-eloquent",
            "options": { "symlink": true }
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
