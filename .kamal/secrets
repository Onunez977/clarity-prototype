# Secrets defined here are resolved from your local shell environment when Kamal runs.
# For a local deploy test, export values first with:
# set -a; source .env.kamal; set +a

# Provided by the caller, not computed here — Kamal's secrets interpolator does
# not support conditional shell expansions like ${VAR:+...}. The Makefile sets it
# via the local ECR profile (make kamal-deploy); CI computes it from its static
# keys in a "Resolve ECR registry password" step before `kamal deploy`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# github-oauth for the private VCS packages insight-lpr/black-adam and
# insight-lpr/laravel-clickhouse (written to ~/.composer/auth.json by the
# kamal-setup action / local `composer config`).
composer_auth=$(cat $HOME/.composer/auth.json)

APP_KEY=$APP_KEY

DB_USERNAME=$DB_USERNAME
DB_PASSWORD=$DB_PASSWORD

REDIS_PASSWORD=$REDIS_PASSWORD

MAIL_USERNAME=$MAIL_USERNAME
MAIL_PASSWORD=$MAIL_PASSWORD

AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
AWS_BUCKET=$AWS_BUCKET

CLICKHOUSE_USERNAME=$CLICKHOUSE_USERNAME
CLICKHOUSE_PASSWORD=$CLICKHOUSE_PASSWORD
CLICKHOUSE_WRITE_USERNAME=$CLICKHOUSE_WRITE_USERNAME
CLICKHOUSE_WRITE_PASSWORD=$CLICKHOUSE_WRITE_PASSWORD

PUSHER_APP_ID=$PUSHER_APP_ID
PUSHER_APP_KEY=$PUSHER_APP_KEY
PUSHER_APP_SECRET=$PUSHER_APP_SECRET

GEOCODIO_API_KEY=$GEOCODIO_API_KEY
CONVERTAPI_SECRET=$CONVERTAPI_SECRET

TWILIO_SID=$TWILIO_SID
TWILIO_TOKEN=$TWILIO_TOKEN

MATCHER_API_KEY=$MATCHER_API_KEY
MCP_BEARER_TOKEN=$MCP_BEARER_TOKEN

# Otto / Bedrock IAM (laravel/ai SigV4). BEDROCK_* is preferred; AWS_BEDROCK_*
# is the vehicle-analysis fallback and is forwarded under its own name.
BEDROCK_KEY=$BEDROCK_KEY
BEDROCK_SECRET=$BEDROCK_SECRET
AWS_BEDROCK_ACCESS_KEY_ID=$AWS_BEDROCK_ACCESS_KEY_ID
AWS_BEDROCK_SECRET_ACCESS_KEY=$AWS_BEDROCK_SECRET_ACCESS_KEY
