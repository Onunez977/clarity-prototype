{
    "name": "insight-lpr/laravel-zod-migrations",
    "description": "Shared Zod PostgreSQL schema migrations for Insight LPR Laravel applications",
    "keywords": [
        "insight-lpr",
        "laravel",
        "zod",
        "migrations",
        "postgresql"
    ],
    "homepage": "https://github.com/insight-lpr/laravel-zod-migrations",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jeffrey Cobb",
            "email": "redacted@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.19.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "InsightLPR\\ZodMigrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InsightLPR\\ZodMigrations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InsightLPR\\ZodMigrations\\ZodMigrationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
