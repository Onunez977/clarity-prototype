{
  "name":"insight-lpr/laravel-clickhouse-eloquent",
  "description":"ClickHouse integration for Laravel with Eloquent-like ORM and query builder",
  "keywords":[
    "php",
    "laravel",
    "clickhouse"
  ],
  "homepage":"https://github.com/insight-lpr/laravel-clickhouse",
  "type":"library",
  "minimum-stability": "stable",
  "require":{
    "php":">=8.3",
    "ext-curl":"*",
    "ext-json":"*",
    "illuminate/support":">=12",
    "illuminate/database":">=12"
  },
  "require-dev":{
    "laravel/framework":">=12",
    "phpunit/phpunit":"^11"
  },
  "suggest":{
  },
  "autoload":{
    "psr-4":{
      "LaravelClickhouseEloquent\\":"src/"
    }
  },
  "autoload-dev":{
    "psr-4":{
      "Tests\\":"tests/"
    }
  }
}
