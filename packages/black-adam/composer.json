{
    "name": "insight-lpr/black-adam",
    "version": "3.4.15",
    "description": "Shared Lib for Laravel apps",
    "keywords": [
        "insight-lpr",
        "laravel",
        "insightlpr"
    ],
    "homepage": "https://github.com/insight-lpr/black-adam",
    "authors": [
        {
            "name": "Jeffrey Cobb",
            "email": "redacted@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "archtechx/enums": "^v1.0.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.19.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0|^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "spatie/laravel-ray": "^1.26",
        "pelmered/fake-car": "^1.7|^2.0"
    },
    "autoload": {
        "files": [
            "src/Support/helpers.php"
        ],
        "psr-4": {
            "InsightLPR\\BlackAdam\\": "src",
            "InsightLPR\\BlackAdam\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InsightLPR\\BlackAdam\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InsightLPR\\BlackAdam\\BlackAdamServiceProvider"
            ],
            "aliases": {
                "BlackAdam": "InsightLPR\\BlackAdam\\Facades\\BlackAdam"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
