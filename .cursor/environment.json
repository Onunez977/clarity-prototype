{
  "name": "Clarity (insight-lpr/platform)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "user": "ubuntu",
  "install": "./.cursor/install.sh",
  "start": "./.cursor/start.sh",
  "repositoryDependencies": [
    "github.com/insight-lpr/laravel-zod-migrations",
    "github.com/insight-lpr/black-adam",
    "github.com/insight-lpr/laravel-clickhouse"
  ],
  "ports": [
    { "name": "Laravel", "port": 8000 },
    { "name": "PostgreSQL", "port": 5432 },
    { "name": "ClickHouse HTTP", "port": 8123 },
    { "name": "ClickHouse native", "port": 9000 },
    { "name": "Redis", "port": 6379 }
  ]
}
