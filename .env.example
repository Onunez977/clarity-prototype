APP_NAME="Clarity Prototype"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8080

# Treat incoming requests as HTTPS (needed for absolute signed URLs behind TLS proxies).
FORCE_HTTPS=false

DEV_LOGIN_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=platform
DB_HOST=127.0.0.1
DB_DATABASE=zod
DB_USERNAME=platform
DB_PASSWORD=platform

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Real-time (Scout zones + Otto chat stream). Production: shared InsightLPR Soketi
# at wss.insightlpr.io. Local (lerd soketi, same as Overwatch):
#   BROADCAST_CONNECTION=pusher
#   PUSHER_APP_ID=lerd PUSHER_APP_KEY=lerd PUSHER_APP_SECRET=lerd
#   PUSHER_HOST=lerd-soketi PUSHER_PORT=6001 PUSHER_SCHEME=http
#   VITE_PUSHER_HOST=localhost VITE_PUSHER_PORT=6001 VITE_PUSHER_SCHEME=http
# Browser uses ws://localhost:6001 — do NOT nginx-proxy /app/ to Soketi on Clarity
# (Filament panel is /app; that proxy would shadow it).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

FILESYSTEM_DISK=local
# Use redis (not sync) locally so Horizon can process {otto} / {high} / {low}.
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bedrock (vehicle analysis + Otto). Prefer BEDROCK_* for laravel/ai IAM SigV4.
# Do not put IAM access keys in a laravel/ai `key` config field — that is bearer API-key auth.
# AWS_BEDROCK_* still works as a fallback for access_key_id / secret_access_key.
AWS_BEDROCK_REGION=us-east-2
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_USE_DEFAULT_CREDENTIALS=false
AWS_BEDROCK_PROFILE=
BEDROCK_KEY=
BEDROCK_SECRET=
VEHICLE_ANALYSIS_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Otto (Clarity admin /app assistant). Requires org_meta.properties.otto_enabled + use-otto permission.
OTTO_PROVIDER=bedrock
OTTO_MODEL=us.xai.grok-4.6
OTTO_TOOL_CALL_LIMIT=50
# USD per 1M tokens for the Datadog cost estimate (input / output / cached read).
OTTO_PRICE_PROMPT_PER_M=2.20
OTTO_PRICE_COMPLETION_PER_M=6.60
OTTO_PRICE_CACHE_READ_PER_M=0.55
# OTTO_KNOWLEDGE_PATH=
OTTO_LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http

GEOCODIO_API_KEY=

TRACK_ANALYTICS=false
CLICKHOUSE_WRITE_USERNAME=platform
CLICKHOUSE_WRITE_PASSWORD=platform

CONVERTAPI_SECRET=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=

MCP_BEARER_TOKEN=

MATCHER_API_KEY=

RDN_METRICS_QUEUE_URL=
RDN_METRICS_AWS_PROFILE=
RDN_METRICS_AWS_REGION=us-east-2

# --- Prototype isolation (do not point these at Insight production) ---
DB_PORT=5432
REDIS_STANDALONE=true
REDIS_HOST_1=127.0.0.1
REDIS_HOST_2=127.0.0.1
CLICKHOUSE_DRIVER=pgsql
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=5432
CLICKHOUSE_HTTPS=false
CLICKHOUSE_DATABASE_CLARITY=zod
CLICKHOUSE_DATABASE_ZOD=zod
CLICKHOUSE_USERNAME=platform
CLICKHOUSE_PASSWORD=platform
CLICKHOUSE_WRITE_USERNAME=platform
CLICKHOUSE_WRITE_PASSWORD=platform
RDN_CASE_INFO_ENABLED=false
RDN_API_URL=http://127.0.0.1:9/
DATADOG_FORWARDING=false
GEOCODING_NOMINATIM=false
NIGHTWATCH_ENABLED=false
AWS_BEDROCK_PROFILE=
